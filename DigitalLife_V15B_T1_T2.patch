     def resolve(self, scope_id: str, source: SourceEnvelope,
                 judgment: JudgmentResult, model_version: str = "") -> ResolutionSummary:
         summary = ResolutionSummary()
+        # Fail closed on partially parsed or mismatched model judgments.
+        # Never persist partial proposals, attach evidence, or add cannot-links
+        # when the judge reported any validation issue.
+        if not judgment.ok or judgment.source_seq != source.source_seq:
+            issues = list(judgment.issues)
+            if judgment.source_seq != source.source_seq:
+                issues.append("source_seq_mismatch")
+            if not judgment.proposals:
+                issues.append("no_valid_proposals")
+            for proposal in judgment.proposals or [None]:
+                summary.deferred += 1
+                summary.decisions.append({
+                    "source_seq": source.source_seq,
+                    "target": proposal.candidate_event_id if proposal else None,
+                    "decision": "DEFERRED",
+                    "reason": "invalid_judgment",
+                    "issues": list(issues),
+                })
+            return summary
         existing = set(self.store.events_for_source(scope_id, source.source_seq))
         same_props = [p for p in judgment.proposals if p.label == "SAME_EVENT"]
         ambiguous_same = len(same_props) > 1
diff --git a/dev/tests/test_v1_5b_t1_t2_fixes.py b/dev/tests/test_v1_5b_t1_t2_fixes.py
new file mode 100644
--- /dev/null
+++ b/dev/tests/test_v1_5b_t1_t2_fixes.py
@@ -0,0 +1,156 @@
+"""Offline regressions for T1 rank fusion and T2 fail-closed resolver.
+
+Run from repo root: python -m unittest discover -s dev/tests -p 'test_v1_5b_t1_t2_fixes.py' -v
+No DeepSeek API, BGE model, or production V1 database is needed.
+"""
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from v1_5_consolidator.candidate_retriever import Candidate, EventAnchor, HybridCandidateIndex
+from v1_5_consolidator.contracts import SourceEnvelope
+from v1_5_consolidator.relation_judge import JudgmentResult, RelationProposal
+from v1_5_consolidator.resolver import ConstrainedResolver
+
+
+class FixedIndex:
+    def __init__(self, candidates):
+        self.candidates = candidates
+
+    def search(self, scope_id, query, k=10):
+        return self.candidates[:k]
+
+
+class RecordingStore:
+    """Pure test double; records every mutation attempted by the resolver."""
+
+    def __init__(self):
+        self.mutations = []
+        self.membership = set()
+        self.allowed = {"evt-a", "evt-b"}
+
+    def events_for_source(self, scope_id, source_seq):
+        return sorted(event for s, seq, event in self.membership
+                      if s == scope_id and seq == source_seq)
+
+    def event_in_scope(self, event_id, scope_id):
+        return scope_id == "s" and event_id in self.allowed
+
+    def cannot_link_exists(self, scope_id, event_a, event_b):
+        return False
+
+    def record_link_proposal(self, scope_id, seq, target, label, reasons, version, request):
+        self.mutations.append(("proposal", scope_id, seq, target, label))
+        return "proposal-" + str(len(self.mutations))
+
+    def record_link_decision(self, proposal_id, scope_id, seq, target, decision, reason):
+        self.mutations.append(("decision", scope_id, seq, target, decision))
+        return "decision-" + str(len(self.mutations))
+
+    def attach_source(self, scope_id, source, target, proposal_id):
+        key = (scope_id, source.source_seq, target)
+        inserted = key not in self.membership
+        self.membership.add(key)
+        self.mutations.append(("attach", scope_id, source.source_seq, target))
+        return inserted
+
+    def add_cannot_link(self, scope_id, event_a, event_b, source_seq):
+        self.mutations.append(("cannot_link", scope_id, source_seq, event_a, event_b))
+
+
+class TestRankFusion(unittest.TestCase):
+    @staticmethod
+    def hybrid(lexical, embedding):
+        index = HybridCandidateIndex()
+        for event_id in ("evt-a", "evt-b", "evt-c"):
+            index.add(EventAnchor(event_id=event_id, scope_id="s", canonical_title=event_id))
+        index.lexical = FixedIndex(lexical)
+        index.embedding = FixedIndex(embedding) if embedding is not None else None
+        return index
+
+    def test_high_lexical_score_does_not_rank_below_low_lexical_score(self):
+        lexical = [Candidate("evt-a", 10.0, ["lexical"]), Candidate("evt-b", 1.0, ["lexical"])]
+        embedding = [Candidate("evt-a", 0.5, ["embedding"]), Candidate("evt-b", 0.5, ["embedding"])]
+        result = self.hybrid(lexical, embedding).search("s", "query", k=2)
+        self.assertEqual([c.event_id for c in result], ["evt-a", "evt-b"])
+        self.assertGreater(result[0].score, result[1].score)
+
+    def test_opposed_rank_tie_prefers_lexical_rank(self):
+        lexical = [Candidate("evt-a", 10, []), Candidate("evt-b", 1, [])]
+        embedding = [Candidate("evt-b", 0.9, []), Candidate("evt-a", 0.8, [])]
+        result = self.hybrid(lexical, embedding).search("s", "query", k=2)
+        self.assertEqual([c.event_id for c in result], ["evt-a", "evt-b"])
+
+    def test_lexical_only_order_is_preserved(self):
+        lexical = [Candidate("evt-b", 3, []), Candidate("evt-a", 2, [])]
+        result = self.hybrid(lexical, None).search("s", "query", k=2)
+        self.assertEqual([c.event_id for c in result], ["evt-b", "evt-a"])
+
+    def test_reasons_and_anchor_versions_are_preserved(self):
+        index = self.hybrid([Candidate("evt-a", 2, ["lexical:a"])],
+                            [Candidate("evt-a", 0.7, ["embedding"])])
+        result = index.search("s", "query", k=1)
+        self.assertEqual(result[0].reasons, ["lexical:a", "embedding"])
+        self.assertEqual(result[0].anchor_version, 1)
+
+
+class TestResolverFailClosed(unittest.TestCase):
+    def setUp(self):
+        self.store = RecordingStore()
+        self.resolver = ConstrainedResolver(self.store)
+        self.source = SourceEnvelope("s", 10, "hash", "2026-11-08", "继续四姑娘山计划")
+
+    def judgment(self, proposals=None, issues=None, seq=10):
+        return JudgmentResult(source_seq=seq,
+                              proposals=proposals if proposals is not None else
+                              [RelationProposal("evt-a", "SAME_EVENT")],
+                              issues=issues or [], request_id="request-1")
+
+    def test_issue_with_valid_same_proposal_cannot_attach_or_write(self):
+        result = self.resolver.resolve("s", self.source,
+                                       self.judgment(issues=["missing:evt-b"]))
+        self.assertEqual(result.attached, 0)
+        self.assertEqual(result.deferred, 1)
+        self.assertEqual(result.decisions[0]["reason"], "invalid_judgment")
+        self.assertEqual(self.store.mutations, [])
+
+    def test_invalid_mixed_relations_cannot_create_cannot_link(self):
+        proposals = [RelationProposal("evt-a", "SAME_EVENT"),
+                     RelationProposal("evt-b", "DIFFERENT_EVENT")]
+        result = self.resolver.resolve("s", self.source,
+                                       self.judgment(proposals, ["candidate_duplicate:evt-a"]))
+        self.assertEqual(result.attached, 0)
+        self.assertEqual(result.cannot_link, 0)
+        self.assertEqual(result.deferred, 2)
+        self.assertEqual(self.store.mutations, [])
+
+    def test_empty_proposals_do_not_mutate(self):
+        result = self.resolver.resolve("s", self.source,
+                                       self.judgment(proposals=[]))
+        self.assertEqual(result.deferred, 1)
+        self.assertEqual(self.store.mutations, [])
+
+    def test_source_sequence_mismatch_is_rejected(self):
+        result = self.resolver.resolve("s", self.source, self.judgment(seq=11))
+        self.assertEqual(result.attached, 0)
+        self.assertIn("source_seq_mismatch", result.decisions[0]["issues"])
+        self.assertEqual(self.store.mutations, [])
+
+    def test_valid_same_proposal_still_attaches(self):
+        result = self.resolver.resolve("s", self.source, self.judgment())
+        self.assertEqual(result.attached, 1)
+        self.assertTrue(any(x[0] == "attach" for x in self.store.mutations))
+
+    def test_valid_duplicate_resolve_is_idempotent(self):
+        self.resolver.resolve("s", self.source, self.judgment())
+        result = self.resolver.resolve("s", self.source, self.judgment())
+        self.assertEqual(result.already_attached, 1)
+        self.assertEqual(result.attached, 0)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
